FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SWING_OPERATION_MODE=simulation \
    SWING_EVENT_DB_PATH=/var/lib/swing/events.sqlite \
    SWING_MODEL_DIR=/app/models

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 swing \
    && useradd --uid 10001 --gid swing --no-create-home --shell /usr/sbin/nologin swing \
    && mkdir -p /var/lib/swing /app/models \
    && chown -R swing:swing /var/lib/swing

COPY requirements-twin.txt ./requirements-twin.txt
RUN python -m pip install -r requirements-twin.txt

COPY modules ./modules
COPY models/rl_optimizer_*.zip ./models/

USER 10001:10001
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8001/health', timeout=3).read()" || exit 1

CMD ["uvicorn", "modules.physics_engine.api:app", "--host", "0.0.0.0", "--port", "8001", "--proxy-headers", "--forwarded-allow-ips", "172.29.245.10"]
