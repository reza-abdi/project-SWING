# Existing: local AI-to-Twin HTTP target; internal Docker network uses http://twin:8001.
DIGITAL_TWIN_API_URL=http://127.0.0.1:8001
# Existing: IEEE 118 simulation startup multipliers (finite positive decimals).
SWING_STARTUP_DERATE=0.15
SWING_STARTUP_LOAD_MULT=1.4
# New: only "simulation" is accepted; no equipment-control mode exists.
SWING_OPERATION_MODE=simulation

# New: co-located files. Relative paths resolve from the project root.
SWING_EVENT_DB_PATH=./data/event_log.db
SWING_DATA_DIR=./data
SWING_MODEL_DIR=./models
SWING_FAISS_DIR=./data/knowledge_base/faiss_index

# New: development service listeners; public hosts require a protected proxy.
SWING_TWIN_BIND_HOST=127.0.0.1
SWING_TWIN_PORT=8001
SWING_AGENT_BIND_HOST=127.0.0.1
SWING_AGENT_PORT=8002
SWING_ALLOWED_ORIGINS=

# New: local mode must remain loopback-only. Configure verified identity before public writes.
SWING_AUTH_MODE=disabled_local_only
SWING_AUTH_ISSUER_URL=
SWING_AUTH_AUDIENCE=
SWING_AUTH_CLIENT_ID=
SWING_AUTH_CLIENT_SECRET=
SWING_SESSION_SECRET=
SWING_INTERNAL_TWIN_TOKEN=

# New: public browser routes are nonsecret and should be same-origin HTTPS/WSS.
SWING_PUBLIC_TWIN_API_BASE=
SWING_PUBLIC_AGENT_API_BASE=
SWING_PUBLIC_TWIN_WS_BASE=

# Existing: optional Google AI key for online chat/decisions; leave blank for offline simulation.
GOOGLE_API_KEY=
# New: select current provider model IDs only after checking availability.
SWING_GEMINI_PRIMARY_MODEL=
SWING_GEMINI_FALLBACK_MODELS=

# New: trusted RAG policy, proposal lifetime, scanner interval, and log level.
SWING_RAG_TRUST_MODE=rebuild
SWING_PROPOSAL_TTL_SECONDS=300
SWING_CONTINGENCY_INTERVAL_SECONDS=30
SWING_LOG_LEVEL=INFO
